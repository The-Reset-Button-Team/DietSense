# =============================================================================
# DietSense — Root Environment Template
# For backend execution, see also backend/.env.example
# =============================================================================

# Path to the local SQLite database
SQLITE_DB_PATH=database/dietsense.db

# Authentication secret for signing local session JWTs
JWT_SECRET=local-development-secret-key-at-least-32-characters-long
JWT_EXPIRE_MINUTES=10080

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Optional Cloud Backend — Supabase
# =============================================================================
DATABASE_PROVIDER=sqlite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# =============================================================================
# Google Gemini API Configuration (Backend Only)
# =============================================================================
# Google AI Studio API Key (obtain from https://aistudio.google.com/)
# Strictly backend-only: NEVER prefix with NEXT_PUBLIC_ or expose to client
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model Selection
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Request Constraints & Optimization
GEMINI_REQUEST_TIMEOUT=12.0
GEMINI_MAX_RETRIES=3
GEMINI_RATE_LIMIT_RPM=60
GEMINI_CACHE_TTL_HOURS=24
AI_FEATURE_ENABLED=true
