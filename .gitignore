# ============================================================
# DietSense .gitignore
# Covers: Next.js, Python, PostgreSQL, Supabase, Env Files
# ============================================================

# ---------- Reference Database Folder (PDFs, ZIPs, SQLite, large files) ----------
# Contains USDA CSV zips, IFCT PDFs, WHO docs, SQLite DB, SQL seeds.
# These are stored locally / on shared drive — NOT committed to git.
database/

# ---------- Environment Variables (NEVER commit secrets) ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env

# ---------- Next.js / Node.js ----------
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
venv/
env/
ENV/
.venv/
*.egg-info/
dist/
build/
*.egg
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.dmypy.json
.pytest_cache/
.ruff_cache/
.hypothesis/

# ---------- Jupyter Notebooks ----------
.ipynb_checkpoints/
*.ipynb

# ---------- Large Data Files (use Git LFS or external storage) ----------
data/raw/*.csv
data/raw/*.zip
data/raw/*.json
data/processed/*.csv
data/processed/*.json
*.crdownload

# ---------- SQLite / Local DB Files ----------
*.db
*.sqlite
*.sqlite3

# ---------- IDE & Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
logs/
*.log

# ---------- Docker ----------
.dockerignore

# ---------- Test Coverage ----------
.coverage
htmlcov/
coverage.xml
