# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supports both anon key and publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key-here

# ─── Site & Auth Redirects ──────────────────────────────────────────────────
# Local development: http://localhost:3000
# Production: your Vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Backend API ─────────────────────────────────────────────────────────────
# Local development: http://localhost:8000
# Production: your Render/Railway backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
