# =============================================================================
# DietSense — Backend Local Environment Configuration
# =============================================================================

# Path to the local SQLite database (defaults to repository database/dietsense.db)
SQLITE_DB_PATH=database/dietsense.db

# Authentication secret for signing local session JWTs (change for production)
JWT_SECRET=local-development-secret-key-at-least-32-characters-long

# JWT token expiration in minutes (default: 7 days)
JWT_EXPIRE_MINUTES=10080

# Environment mode: 'development' or 'production'
ENVIRONMENT=development

# Allowed CORS origins (comma-separated list for frontend clients)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
